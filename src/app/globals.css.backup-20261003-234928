/* HOME — FOTOGRAFIA, DEGRADÊ E POSICIONAMENTO */
.home-hero {
  position: relative;
  isolation: isolate;
  background-color: #12343b;
  background-image:
    linear-gradient(
      90deg,
      rgba(18, 52, 59, 0.97) 0%,
      rgba(18, 52, 59, 0.91) 28%,
      rgba(18, 52, 59, 0.55) 53%,
      rgba(18, 52, 59, 0.10) 100%
    ),
    url("/images/home-carnaval.png");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

/* A fotografia substitui a textura e o desenho circular originais. */
.home-hero .hero-texture,
.home-hero .hero-motif {
  display: none;
}

/* Evita um segundo degradê sobre a fotografia. */
.home-hero::after {
  display: none;
}

.hero-copy {
  position: relative;
  z-index: 2;
}

/* Em telas grandes, aproxima o título da borda esquerda e desloca
   as informações secundárias para a direita. */
@media (min-width: 1060px) {
  .home-hero {
    padding-left: max(5vw, calc((100vw - 1380px) / 2));
  }

  .hero-side-note {
    right: 3%;
    top: 15%;
    font-size: 12px;
    line-height: 1.7;
    letter-spacing: 0.12em;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.6);
  }

  .hero-index {
    right: 3%;
    bottom: 35px;
    font-size: 11px;
    line-height: 1.6;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.6);
  }

  .hero-index span:first-child {
    font-size: 34px;
  }
}

/* Maior proteção de contraste quando a fotografia é recortada no celular. */
@media (max-width: 560px) {
  .home-hero {
    background-image:
      linear-gradient(
        90deg,
        rgba(18, 52, 59, 0.96),
        rgba(18, 52, 59, 0.78)
      ),
      url("/images/home-carnaval.png");
    background-position: 65% center;
  }
}
/* Limpeza visual da página inicial */

.home-hero .hero-side-note,
.home-hero .hero-index {
  display: none;
}
/* Controle discreto da órbita */

.orbit-controls {
  display: flex;
  justify-content: center;
  margin: 12px 0 18px;
}

.orbit-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  padding: 0;
  color: var(--green-ink);
  background: transparent;
  border: 0;
  border-radius: 50%;
  cursor: pointer;
}

.orbit-toggle:hover {
  color: var(--petrol);
  background: rgba(35, 134, 123, 0.12);
}

.orbit-toggle:focus-visible {
  outline: 2px solid var(--green);
  outline-offset: 3px;
}

.orbit-toggle:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}